  position:relative;
  width:240px;height:240px;
  margin:10px auto 0;
  perspective:900px;
  perspective-origin:50% 40%;
  z-index:2;
}
.cube{
  position:relative;
  width:200px;height:200px;
  margin:20px auto;
  transform-style:preserve-3d;
  transform:rotateX(-20deg) rotateY(0deg);
  transition:transform .1s linear;
}
.face{
  position:absolute;
  width:200px;height:200px;
  border:2.5px solid rgba(255,213,74,.5);
  display:flex;align-items:center;justify-content:center;
  font-size:96px;line-height:1;
  background:linear-gradient(135deg,#ff9567 0%,#ff5b3e 50%,#c93418 100%);
  box-shadow:inset 0 0 40px rgba(0,0,0,.3),0 0 30px rgba(255,91,62,.4);
  text-shadow:0 6px 16px rgba(0,0,0,.4);
}
.face::before{content:"";position:absolute;inset:10px;border:2px dashed rgba(255,255,255,.4);border-radius:10px;pointer-events:none;}
.face::after{content:"";position:absolute;top:50%;left:14px;right:14px;height:2px;background:rgba(255,213,74,.6);transform:translateY(-50%);pointer-events:none;}
.face.front{transform:translateZ(100px);}
.face.back{transform:rotateY(180deg) translateZ(100px);background:linear-gradient(135deg,#ffb088 0%,#ff7150 50%,#c93418 100%);}
.face.right{transform:rotateY(90deg) translateZ(100px);background:linear-gradient(135deg,#ff7a5a 0%,#e84a2f 50%,#a02818 100%);}
.face.left{transform:rotateY(-90deg) translateZ(100px);background:linear-gradient(135deg,#ffa07a 0%,#ff5b3e 50%,#b02818 100%);}
.face.top{transform:rotateX(90deg) translateZ(100px);background:linear-gradient(135deg,#ffd699 0%,#ff9567 50%,#c93418 100%);font-size:56px;}
.face.bottom{transform:rotateX(-90deg) translateZ(100px);background:linear-gradient(135deg,#a02818 0%,#7a1c10 50%,#4a0c08 100%);font-size:42px;}

/* 舞台内的中奖提示（居中显示） */
.stage-prompt{
  position:absolute;left:0;right:0;bottom:14px;z-index:3;
  display:flex;flex-direction:column;align-items:center;gap:2px;
  opacity:0;transition:opacity .4s;
  pointer-events:none;
}
.stage-prompt.show{opacity:1;}
.stage-prompt .trophy-emoji{font-size:0;line-height:0;}
.stage-prompt .stage-rank{font-size:11px;color:#ffd54a;font-weight:600;letter-spacing:1px;margin-top:6px;text-shadow:0 1px 2px rgba(0,0,0,.6);}
.stage-prompt .stage-prize{font-size:13px;color:#fff;font-weight:700;margin-top:2px;text-shadow:0 1px 3px rgba(0,0,0,.6);}
.stage-prompt .stage-prize .em{font-size:18px;}

/* 移动端的 prompt/code-box 隐藏（舞台内已显示） */
@media (max-width:719px){
  .prompt,.amount-box{display:none;}
}

}

/* 桌面端手机壳内自适应 */

  .stage{padding:0 14px;}
  
  .cta-wrap{width:auto;}
}
</style>
</head>
