<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#ff5b3e">
<title>我的钱包 · 宜必购</title>
<link rel="icon" href="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='80' font-size='90'%3E%F0%9F%92%B0%3C/text%3E%3C/svg%3E">
<style>
﻿:root{--c-primary:#ff5b3e;--c-primary-600:#e84a2f;--c-primary-100:#ffe9e3;--c-accent:#ffb547;--c-success:#16a34a;--c-success-bg:#e8f7ee;--c-warning:#f59e0b;--c-warning-bg:#fff6e0;--c-danger:#dc2626;--c-danger-bg:#fde8e8;--c-info:#2563eb;--c-info-bg:#e6efff;--c-text:#1f2330;--c-text-2:#5a6072;--c-text-3:#8a90a2;--c-bg:#f6f7fb;--c-surface:#fff;--c-border:#ececf3;--c-divider:#f0f1f6;--c-grad-1:linear-gradient(135deg,#ff7150 0%,#ff9567 100%);--r-md:10px;--r-lg:14px;--r-xl:20px;--r-pill:999px;--sh-1:0 1px 3px rgba(20,23,40,.06),0 1px 6px rgba(20,23,40,.04);--sh-2:0 8px 24px rgba(255,91,62,.15);}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--c-text);background:var(--c-bg);-webkit-font-smoothing:antialiased;font-size:15px;}
body{min-height:100vh;padding-bottom:calc(72px + env(safe-area-inset-bottom));}
a{color:inherit;text-decoration:none;}
input,select,button{font-size:16px;}
button{font-family:inherit;}
.hero{background:linear-gradient(160deg,#ff5b3e 0%,#ff7150 40%,#ff9567 100%);color:#fff;padding:40px 20px 64px;position:relative;overflow:hidden;border-radius:0 0 28px 28px;}
.hero::before{content:"";position:absolute;top:-60px;right:-40px;width:200px;height:200px;background:rgba(255,255,255,.1);border-radius:50%;}
.hero::after{content:"\01F4B0";position:absolute;font-size:140px;opacity:.14;right:-16px;bottom:-20px;transform:rotate(-10deg);pointer-events:none;}
.hero h1{font-size:20px;font-weight:700;position:relative;z-index:1;}
.hero .sub{margin-top:4px;font-size:13px;opacity:.88;position:relative;z-index:1;}
.hero .phone-chip{display:inline-flex;align-items:center;gap:6px;margin-top:12px;padding:5px 12px;background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.28);border-radius:var(--r-pill);font-size:12px;backdrop-filter:blur(6px);position:relative;z-index:1;}
.bal-hero{margin-top:18px;position:relative;z-index:1;}
.bal-hero .label{font-size:13px;opacity:.85;}
.bal-hero .amount{display:flex;align-items:flex-end;gap:4px;margin-top:4px;}
.bal-hero .sym{font-size:20px;opacity:.9;padding-bottom:6px;}
.bal-hero .num{font-size:40px;font-weight:800;letter-spacing:.5px;line-height:1;}
.bal-stats{display:flex;gap:8px;margin-top:14px;position:relative;z-index:1;}
.bal-stats .pill{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:var(--r-pill);font-size:12px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.24);}
.container{max-width:560px;margin:-40px 16px 0;padding:0 0 24px;position:relative;z-index:2;}
@media(min-width:768px){.container{margin-left:auto;margin-right:auto;}body{background:#eceef4;}}
.card{background:#fff;border-radius:var(--r-lg);padding:16px;box-shadow:var(--sh-1);margin-bottom:12px;border:1px solid var(--c-border);}
.card-title{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;margin-bottom:12px;}
.card-title .ic{width:28px;height:28px;border-radius:9px;background:var(--c-primary-100);color:var(--c-primary);display:inline-flex;align-items:center;justify-content:center;font-size:16px;flex:0 0 28px;}
.card-title .more{margin-left:auto;font-size:12px;color:var(--c-primary);cursor:pointer;font-weight:400;}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.quick-btn{display:flex;flex-direction:column;align-items:center;gap:6px;padding:16px 12px;border-radius:var(--r-lg);text-decoration:none;font-weight:600;font-size:14px;text-align:center;transition:transform .12s;}
.quick-btn:active{transform:scale(.97);}
.quick-btn.draw{background:linear-gradient(135deg,#ff7150,#ff9567);color:#fff;}
.quick-btn.recharge{background:linear-gradient(135deg,#3b82f6,#06b6d4);color:#fff;}
.quick-btn .em{font-size:28px;}
.quick-btn .hint{font-size:11px;opacity:.85;font-weight:400;margin-top:2px;}
.qr-card{display:flex;gap:14px;align-items:center;padding:16px;background:#fff;border-radius:var(--r-lg);box-shadow:var(--sh-1);margin-bottom:12px;border:1px solid var(--c-border);}
.qr-card .qr{width:110px;height:110px;border-radius:12px;background:#fafbff;display:flex;align-items:center;justify-content:center;color:#888;font-size:12px;overflow:hidden;flex:0 0 110px;}
.qr-card .qr img,.qr-card .qr svg{width:100%;height:100%;}
.qr-card .info{flex:1;}
.qr-card .info h3{font-size:15px;font-weight:600;margin-bottom:4px;}
.qr-card .info p{font-size:12px;color:var(--c-text-3);line-height:1.5;}
.qr-card .info .badge{display:inline-block;padding:2px 8px;border-radius:var(--r-pill);font-size:11px;background:var(--c-success-bg);color:var(--c-success);margin-bottom:6px;}
.qr-card .actions{display:flex;gap:8px;margin-top:8px;}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:40px;padding:0 14px;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:transform .12s;}
.btn:active{transform:scale(.97);}
.btn--primary{background:var(--c-primary);color:#fff;}
.btn--soft{background:var(--c-primary-100);color:var(--c-primary);}
.btn--ghost{background:transparent;color:var(--c-text-2);border:1px solid var(--c-border);}
.login-row{display:flex;gap:8px;align-items:center;}
.login-row input{flex:1;height:44px;padding:0 12px;border:1px solid var(--c-border);border-radius:10px;font-size:15px;background:#fff;}
.login-row input:focus{outline:none;border-color:var(--c-primary);}
.login-row .btn{height:44px;padding:0 16px;font-size:14px;}
.seg{display:flex;background:#eef0f4;border-radius:var(--r-pill);padding:3px;margin:8px 0 12px;}
.seg button{appearance:none;border:none;background:transparent;flex:1;padding:8px 4px;font-size:13px;color:var(--c-text-2);border-radius:var(--r-pill);cursor:pointer;}
.seg button.active{background:#fff;color:var(--c-primary);box-shadow:0 1px 4px rgba(0,0,0,.06);font-weight:600;}
.coupon{display:flex;gap:0;align-items:stretch;background:linear-gradient(180deg,#fff8f3 0%,#fff 70%);border:1px dashed #ffc8b4;border-radius:var(--r-lg);margin-bottom:10px;overflow:hidden;}
.coupon.used{opacity:.55;}
.coupon .left{flex:0 0 88px;background:linear-gradient(135deg,#ff7150,#ff9567);color:#fff;padding:14px 8px;text-align:center;position:relative;display:flex;flex-direction:column;justify-content:center;}
.coupon .left::after{content:"";position:absolute;right:-6px;top:50%;transform:translateY(-50%);width:12px;height:12px;background:#fff;border-radius:50%;}
.coupon .left .v{font-size:22px;font-weight:800;line-height:1;}
.coupon .left .u{font-size:10px;margin-top:3px;opacity:.85;}
.coupon .right{flex:1;padding:12px 14px;}
.coupon .name{font-size:14px;font-weight:600;}
.coupon .desc{font-size:12px;color:var(--c-text-3);margin-top:4px;line-height:1.5;}
.coupon .meta{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;}
.coupon .badge{display:inline-block;padding:2px 8px;border-radius:var(--r-pill);font-size:11px;background:var(--c-primary-100);color:var(--c-primary);}
.flow{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--c-divider);}
.flow:last-child{border-bottom:none;}
.flow .ic{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;flex:0 0 32px;}
.flow.in .ic{background:var(--c-success-bg);color:var(--c-success);}
.flow.out .ic{background:var(--c-danger-bg);color:var(--c-danger);}
.flow .main{flex:1;min-width:0;}
.flow .main .t{font-size:14px;font-weight:600;}
.flow .main .s{font-size:12px;color:var(--c-text-3);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.flow .amt{font-size:15px;font-weight:700;}
.flow.in .amt{color:var(--c-success);}
.flow.out .amt{color:var(--c-danger);}
.msg-item{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid var(--c-divider);}
.msg-item:last-child{border-bottom:none;}
.msg-item .ic{width:34px;height:34px;border-radius:10px;background:var(--c-info-bg);color:var(--c-info);display:flex;align-items:center;justify-content:center;flex:0 0 34px;font-size:16px;}
.msg-item.unread .ic{background:var(--c-danger-bg);color:var(--c-danger);}
.msg-item .main{flex:1;min-width:0;}
.msg-item .main .t{font-size:14px;font-weight:600;}
.msg-item .main .s{font-size:12px;color:var(--c-text-3);margin-top:3px;line-height:1.5;}
.empty{padding:28px 16px;text-align:center;color:var(--c-text-3);font-size:13px;}
.empty .emoji{font-size:36px;margin-bottom:8px;}
.mask{position:fixed;inset:0;background:rgba(10,12,24,.55);z-index:90;display:none;align-items:flex-end;justify-content:center;}
.mask.show{display:flex;}
.modal{background:#fff;width:100%;max-width:560px;border-radius:22px 22px 0 0;padding:24px 20px calc(24px + env(safe-area-inset-bottom));animation:su .26s cubic-bezier(.2,.7,.2,1);max-height:88vh;overflow-y:auto;}
@keyframes su{from{transform:translateY(40%);opacity:.6;}to{transform:none;opacity:1;}}
.modal h3{font-size:18px;text-align:center;margin-bottom:6px;}
.modal .sub{font-size:13px;color:var(--c-text-3);text-align:center;margin-bottom:16px;}
.qrbox{margin:0 auto 16px;width:220px;height:220px;background:#fafbff;border:1px solid var(--c-border);border-radius:16px;padding:12px;display:flex;align-items:center;justify-content:center;}
.qrbox svg,.qrbox img{width:100%;height:100%;}
.modal .desc{font-size:12px;color:var(--c-text-3);text-align:center;line-height:1.6;margin-bottom:16px;}
.modal .btn{width:100%;height:46px;font-size:15px;}
.toast-host{position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:80;display:flex;flex-direction:column;gap:6px;pointer-events:none;}
.toast{padding:10px 16px;border-radius:10px;background:rgba(0,0,0,.84);color:#fff;font-size:14px;opacity:0;transform:translateY(-6px);transition:opacity .2s,transform .2s;}
.toast.show{opacity:1;transform:none;}
.toast.success{background:#16a34a;}
.toast.warning{background:#f59e0b;}
.toast.danger{background:#dc2626;}
.tabs{position:fixed;bottom:0;left:0;right:0;height:calc(60px + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);backdrop-filter:blur(10px);display:flex;border-top:1px solid var(--c-border);z-index:50;padding-bottom:env(safe-area-inset-bottom);}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--c-text-3);font-size:11px;cursor:pointer;transition:color .15s;}
.tab .ic{font-size:22px;transition:transform .15s;}
.tab.active{color:var(--c-primary);font-weight:600;}
.tab.active .ic{transform:translateY(-2px) scale(1.1);}
</style>
</head>
<body>
﻿<div class="hero">
  <h1>💰 我的钱包</h1>
  <div class="sub">余额 / 优惠券 / 流水 / 身份码</div>
  <div class="phone-chip">📱 <span id="phoneShow">未登录</span></div>
  <div class="bal-hero">
    <div class="label">可用余额（元）</div>
    <div class="amount"><span class="sym">¥</span><span class="num" id="balNum">0.00</span></div>
  </div>
  <div class="bal-stats">
    <span class="pill">🎫 优惠券 <b id="couponCnt">0</b></span>
    <span class="pill">🔔 未读 <b id="msgCnt">0</b></span>
  </div>
</div>

<div class="container">

  <div class="card" id="quickActionCard">
    <div class="quick-grid">
      <a href="/h5/customer/draw.html" class="quick-btn draw">
        <span class="em">🎁</span>
        <span>开盲盒抽奖</span>
        <span class="hint">中奖自动进钱包</span>
      </a>
      <a href="/h5/customer/wallet.html?tab=recharge" class="quick-btn recharge">
        <span class="em">💰</span>
        <span>充值余额</span>
        <span class="hint">仅本店消费可用</span>
      </a>
    </div>
  </div>

  <div class="qr-card">
    <div class="qr" id="qrDynamic" aria-label="动态码">加载中</div>
    <div class="info">
      <span class="badge">⚡ 120秒刷新</span>
      <h3>动态核销码</h3>
      <p>到店出示给商家核销 / 抵扣</p>
      <div class="actions">
        <button class="btn btn--primary" id="btnRefreshQr">🔄 刷新</button>
        <button class="btn btn--ghost" id="btnShowIdentity">🪪 身份码</button>
      </div>
    </div>
  </div>

  <div class="card" id="loginCard">
    <div class="card-title"><span class="ic">📱</span>登录账号</div>
    <div class="login-row">
      <input id="phoneIn" placeholder="请输入手机号" inputmode="numeric" maxlength="11">
      <button class="btn btn--primary" id="btnLogin">登录</button>
    </div>
    <div style="font-size:12px;color:var(--c-text-3);margin-top:8px;">测试环境验证码固定为 <b>123456</b></div>
  </div>

  <div class="card" id="couponCard">
    <div class="card-title">
      <span class="ic">🎫</span>我的优惠券
      <span class="more" id="couponHint">--</span>
    </div>
    <div class="seg" id="couponSeg">
      <button class="active" data-st="0">未使用</button>
      <button data-st="1">已使用</button>
      <button data-st="2">已过期</button>
    </div>
    <div id="couponList"></div>
  </div>

  <div class="card" id="flowCard">
    <div class="card-title"><span class="ic">📊</span>余额流水<span class="more">最近20条</span></div>
    <div id="flowList"></div>
  </div>

  <div class="card" id="msgCard">
    <div class="card-title"><span class="ic">🔔</span>消息中心<span class="more" id="msgMore"></span></div>
    <div id="msgList"></div>
  </div>

</div>

<div class="mask" id="identityMask">
  <div class="modal">
    <h3>🪪 我的身份码</h3>
    <div class="sub">给商家扫码即可核销会员身份与余额</div>
    <div class="qrbox" id="identityQr">加载中</div>
    <div class="desc">退款时商家可凭此码定位历史订单</div>
    <button class="btn btn--primary" id="btnCloseIdentity">关闭</button>
  </div>
</div>

<div class="toast-host" id="toastHost"></div>

<nav class="tabs" aria-label="主导航">
  <div class="tab" data-go="/h5/customer/index.html"><span class="ic">🎯</span><span>抽盒</span></div>
  <div class="tab active" data-go="/h5/customer/wallet.html"><span class="ic">💰</span><span>钱包</span></div>
  <div class="tab" data-go="/h5/customer/ibigou.html"><span class="ic">🛍</span><span>商城</span></div>
</nav>

<script>
<script>
function maskPhone(phone){
  if (!phone) return '';
  var s = String(phone).trim();
  if (/^1\d{10}$/.test(s)) return s.slice(0,3) + '****' + s.slice(7);
  return s;
}
const $ = id => document.getElementById(id);
const A = "/api/customer";

function toast(msg, type){
  const host = $("toastHost"); if (!host) return;
  const t = document.createElement("div"); t.className = "toast " + (type || ""); t.textContent = msg;
  host.appendChild(t);
  requestAnimationFrame(function(){ t.classList.add("show"); });
  setTimeout(function(){ t.classList.remove("show"); setTimeout(function(){ t.remove(); }, 220); }, 2400);
}

async function api(path, method, body){
  const params = new URLSearchParams();
  if (body) Object.keys(body).forEach(function(k){ const v = body[k]; if (v !== undefined && v !== null && v !== "") params.append(k, v); });
  const headers = {};
  const tk = localStorage.getItem("ibigou_user_token");
  if (tk) headers["X-User-Token"] = tk;
  const opt = { method: method || "GET", headers: headers };
  if (method === "POST" || method === "PUT" || method === "DELETE") { headers["Content-Type"] = "application/x-www-form-urlencoded"; opt.body = params.toString(); }
  const r = await fetch(A + path, opt).then(function(r){ return r.json(); });
  if (r.code === 401) { localStorage.removeItem("ibigou_user_token"); toast("登录已过期，请重新登录", "warning"); }
  return r;
}
const typeName = { 1:"折扣券", 2:"立减券", 3:"余额赠送", 4:"团购免单" };
const statusName = { 0:"未使用", 1:"已使用", 2:"已过期", 3:"已作废" };

document.querySelectorAll(".tab").forEach(function(el){
  el.addEventListener("click", function(){
    const href = el.dataset.go; if (href && location.pathname.indexOf(href) === -1) location.href = href;
  });
});

let currentTab = 0;
document.querySelectorAll("#couponSeg button").forEach(function(b){
  b.addEventListener("click", function(){
    document.querySelectorAll("#couponSeg button").forEach(function(x){ x.classList.remove("active"); });
    b.classList.add("active"); currentTab = Number(b.dataset.st); loadCoupons();
  });
});

const lastPhone = localStorage.getItem("ibigou_phone");
if (lastPhone) { $("phoneIn").value = lastPhone; if ($("phoneShow")) $("phoneShow").textContent = maskPhone(lastPhone); }

$("btnLogin").onclick = async function(){
  const ph = $("phoneIn").value.trim();
  if (!/^1[3-9]\d{9}$/.test(ph)) { toast("手机号格式不正确", "warning"); return; }
  $("btnLogin").disabled = true;
  try {
    await api("/auth/send-code", "POST", { userPhone: ph });
    const r = await api("/auth/login", "POST", { userPhone: ph, code: "123456" });
    if (r.code === 0) {
      localStorage.setItem("ibigou_user_token", r.data);
      localStorage.setItem("ibigou_phone", ph);
      if ($("phoneShow")) $("phoneShow").textContent = maskPhone(ph);
      toast("登录成功", "success"); refreshAll();
    } else { toast(r.msg || "登录失败", "danger"); }
  } catch (err) { toast("网络异常", "danger"); }
  finally { $("btnLogin").disabled = false; }
};

$("btnRefreshQr").onclick = refreshAll;
$("btnShowIdentity").onclick = function(){ $("identityMask").classList.add("show"); loadIdentityQr(); };
$("btnCloseIdentity").onclick = function(){ $("identityMask").classList.remove("show"); };

async function loadWallet(){
  const ph = localStorage.getItem("ibigou_phone");
  if (!ph) { $("balNum").textContent = "--"; return; }
  const r = await api("/wallet/" + ph, "GET");
  if (r.code === 0 && r.data) {
    $("balNum").textContent = (r.data.balance != null ? Number(r.data.balance) : 0).toFixed(2);
    $("couponCnt").textContent = (r.data.available || []).length;
  } else { $("balNum").textContent = "0.00"; }
}

async function loadCoupons(){
  const ph = localStorage.getItem("ibigou_phone");
  if (!ph) { $("couponList").innerHTML = '<div class="empty"><div class="emoji">🎫</div>请先登录</div>'; return; }
  const r = await api("/wallet/" + ph, "GET");
  const all = (r.data && r.data.coupons) || [];
  const list = all.filter(function(c){
    if (currentTab === 0) return c.status === 0;
    if (currentTab === 1) return c.status === 1;
    return c.status === 2 || c.status === 3;
  });
  $("couponHint").textContent = "共 " + list.length + " 张";
  if (!list.length) {
    $("couponList").innerHTML = '<div class="empty"><div class="emoji">🎫</div>暂无优惠券</div>';
    return;
  }
  $("couponList").innerHTML = list.map(function(c){
    const used = c.status !== 0;
    const v = c.prizeType === 1 ? (c.prizeValue + "折") : ("¥" + c.prizeValue);
    const expire = c.validEnd || c.expireTime || "";
    const desc = (expire ? expire.replace("T", " ").slice(0, 16) + " 到期" : "") + (c.sourceMerchantNo ? " · 发行 " + c.sourceMerchantNo : "");
    return '<div class="coupon' + (used ? " used" : "") + '">'
      + '<div class="left"><div class="v">' + v + '</div><div class="u">' + (typeName[c.prizeType] || "优惠券") + '</div></div>'
      + '<div class="right"><div class="name">' + (typeName[c.prizeType] || "优惠券") + ' · ' + (c.couponId || "") + '</div>'
      + '<div class="desc">' + desc + '</div>'
      + '<div class="meta"><span class="badge">' + (statusName[c.status] || "") + '</span>'
      + (c.canUseAfterDraw === 0 ? '<span class="badge" style="background:#fff6e0;color:#b45309;">待激活</span>' : '')
      + '</div></div></div>';
  }).join("");
}

async function loadFlow(){
  const ph = localStorage.getItem("ibigou_phone");
  if (!ph) { $("flowList").innerHTML = '<div class="empty"><div class="emoji">📊</div>暂无流水</div>'; return; }
  const r = await api("/wallet/" + ph, "GET");
  const flows = (r.data && r.data.flows) || [];
  if (!flows.length) {
    $("flowList").innerHTML = '<div class="empty"><div class="emoji">📊</div>暂无流水</div>';
    return;
  }
  const ftName = { 1:"发放", 2:"抵扣", 3:"退款", 4:"跨店返还", 5:"宜必购抵扣" };
  $("flowList").innerHTML = flows.slice(0, 20).map(function(f){
    const isIn = f.flowType === 1 || f.flowType === 3 || f.flowType === 4;
    return '<div class="flow ' + (isIn ? "in" : "out") + '">'
      + '<div class="ic">' + (isIn ? "+" : "−") + '</div>'
      + '<div class="main"><div class="t">' + (ftName[f.flowType] || "流水") + '</div>'
      + '<div class="s">' + ((f.createTime || "").replace("T", " ").slice(0, 16))
      + (f.bizNo ? " · " + f.bizNo : "") + (f.remark ? " · " + f.remark : "") + '</div></div>'
      + '<div class="amt">' + (isIn ? "+" : "−") + '¥' + (Number(f.amount || 0)).toFixed(2) + '</div>'
      + '</div>';
  }).join("");
}

async function loadMessages(){
  const ph = localStorage.getItem("ibigou_phone");
  if (!ph) { $("msgList").innerHTML = '<div class="empty"><div class="emoji">🔔</div>暂无消息</div>'; $("msgCnt").textContent = 0; return; }
  const r = await api("/messages/" + ph, "GET");
  let data = r.data || [];
  if (!Array.isArray(data)) data = data.list || [];
  const unread = await api("/messages/" + ph + "/unread-count", "GET");
  $("msgCnt").textContent = (unread.data != null ? unread.data : 0);
  if (!data.length) { $("msgList").innerHTML = '<div class="empty"><div class="emoji">🔔</div>暂无消息</div>'; return; }
  $("msgList").innerHTML = data.slice(0, 15).map(function(m){
    const read = m.read === 1 || m.isRead === 1 || m.readStatus === 1;
    return '<div class="msg-item' + (read ? "" : " unread") + '" onclick="markRead(' + (m.messageId || m.id || 0) + ')">'
      + '<div class="ic">📣</div>'
      + '<div class="main"><div class="t">' + (m.title || "系统通知") + '</div>'
      + '<div class="s">' + (m.content || "") + '<br>' + ((m.createTime || "").replace("T", " ").slice(0, 16)) + '</div></div>'
      + '</div>';
  }).join("");
  $("msgMore").innerHTML = '<a style="color:#ff5b3e;cursor:pointer;" onclick="markAllRead()">全部已读</a>';
}
window.markRead = async function(id){
  const ph = localStorage.getItem("ibigou_phone");
  if (!id) return;
  await api("/messages/" + id + "/read", "POST", { userPhone: ph });
  loadMessages();
};
window.markAllRead = async function(){
  const ph = localStorage.getItem("ibigou_phone");
  const r = await api("/messages/read-all", "POST", { userPhone: ph });
  if (r.code === 0) { toast("已全部标记为已读", "success"); loadMessages(); }
};

async function loadDynamicQr(){
  const ph = localStorage.getItem("ibigou_phone");
  const el = $("qrDynamic");
  if (!ph) { el.textContent = "请先登录"; return; }
  el.innerHTML = "加载中…";
  const r = await api("/qr/dynamic/" + ph, "GET");
  if (r.code === 0 && r.data) {
    const content = r.data.content || r.data.token || "";
    if (r.data.qrSvg) { el.innerHTML = r.data.qrSvg; return; }
    const svg = await api("/qr-svg", "POST", { content: content });
    if (svg.code === 0 && svg.data && svg.data.svg) el.innerHTML = svg.data.svg;
    else el.textContent = content;
  } else { el.textContent = "请稍后"; }
}

async function loadIdentityQr(){
  const ph = localStorage.getItem("ibigou_phone");
  const el = $("identityQr");
  if (!ph) { el.textContent = "请先登录"; return; }
  el.innerHTML = "加载中…";
  const r = await api("/identity-qr/" + ph, "GET");
  if (r.code === 0 && r.data) {
    const svg = await api("/qr-svg", "POST", { content: r.data });
    if (svg.code === 0 && svg.data && svg.data.svg) el.innerHTML = svg.data.svg;
    else el.textContent = r.data;
  } else { el.textContent = "请稍后"; }
}

function refreshAll(){ loadWallet(); loadCoupons(); loadFlow(); loadMessages(); loadDynamicQr(); }

setInterval(function(){ if (localStorage.getItem("ibigou_phone")) loadDynamicQr(); }, 120000);
refreshAll();

