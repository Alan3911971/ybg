    {
      "name": "JobService",
      "type": "service",
      "injects": [
        "couponRepository",
        "flowRepository",
        "flowCloseService",
        "messageService",
        "alertService"
      ],
      "methods": [
        "expireCoupons",
        "expireRemind",
        "compensateDrawBatch",
        "payReconciler",
        "archiveClean"
      ],
      "scheduled": [
        {
          "cron": "0 5 * * * ?",
          "method": "expireCoupons"
        },
        {
          "cron": "0 30 9 * * ?",
          "method": "expireRemind"
        },
        {
          "cron": "0 */5 * * * ?",
          "method": "compensateDrawBatch"
        },
        {
          "cron": "0 */5 * * * ?",
          "method": "payReconciler"
        },
        {
          "cron": "0 20 3 * * ?",
          "method": "archiveClean"
        }
      ]
    },
