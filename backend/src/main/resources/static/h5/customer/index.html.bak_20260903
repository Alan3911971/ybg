<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
<meta name="theme-color" content="#ff5b3e">
<title>盒抽奖 · 宜必购</title>
<link rel="icon" href="data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='80' font-size='90'%3E%F0%9F%8E%81%3C/text%3E%3C/svg%3E">
<style>
:root{--c-primary:#ff5b3e;--c-primary-600:#e84a2f;--c-primary-100:#ffe9e3;--c-success:#16a34a;--c-success-bg:#e8f7ee;--c-warning:#f59e0b;--c-warning-bg:#fff6e0;--c-text:#1a1d29;--c-text-2:#5f6478;--c-text-3:#9095a8;--c-bg:#f7f8fb;--c-surface:#fff;--c-border:#eceef3;--c-divider:#f1f2f6;--c-grad-1:linear-gradient(135deg,#ff7150 0%,#ff9567 100%);--c-grad-gold:linear-gradient(135deg,#ffd54a 0%,#ff9567 100%);--c-grad-dark:linear-gradient(160deg,#3a1f6e 0%,#1a0f3d 70%,#0a0520 100%);}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;color:var(--c-text);background:var(--c-bg);-webkit-font-smoothing:antialiased;font-size:15px;overflow-x:hidden;}
body{min-height:100vh;padding-bottom:calc(60px + env(safe-area-inset-bottom));}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
.hero{background:var(--c-grad-dark);color:#fff;padding:40px 20px 32px;position:relative;overflow:hidden;border-radius:0 0 28px 28px;}
.hero::before{content:"";position:absolute;top:-60px;right:-40px;width:200px;height:200px;background:rgba(255,213,74,.08);border-radius:50%;}
.hero::after{content:"\01F381";position:absolute;font-size:140px;opacity:.06;right:-12px;bottom:-24px;transform:rotate(-8deg);pointer-events:none;}
.hero .shop-row{display:flex;align-items:center;gap:10px;position:relative;z-index:1;}
.hero .avatar{width:40px;height:40px;border-radius:10px;background:var(--c-grad-1);display:flex;align-items:center;justify-content:center;font-size:20px;flex:0 0 40px;}
.hero .shop-name{font-size:16px;font-weight:700;line-height:1.2;}
.hero .shop-sub{font-size:11px;color:rgba(255,255,255,.5);margin-top:2px;}
.hero .chip{display:inline-flex;align-items:center;gap:4px;margin-top:12px;padding:4px 12px;border-radius:999px;font-size:11px;background:rgba(255,213,74,.12);border:1px solid rgba(255,213,74,.3);color:#ffd54a;position:relative;z-index:1;}
.hero h1{font-size:26px;font-weight:800;margin-top:18px;position:relative;z-index:1;line-height:1.3;}
.hero h1 .accent{color:#ffd54a;}
.hero .tagline{font-size:13px;color:rgba(255,255,255,.6);margin-top:6px;position:relative;z-index:1;line-height:1.5;}
.prizes{max-width:480px;margin:-24px auto 0;padding:0 16px;position:relative;z-index:2;}
.prizes .label{font-size:13px;font-weight:700;color:var(--c-text);margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.prizes .label .count{font-size:11px;color:var(--c-text-3);font-weight:400;}
.prize-scroll{display:flex;gap:10px;overflow-x:auto;padding:2px 0 8px;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
.prize-scroll::-webkit-scrollbar{display:none;}
.prize-card{flex:0 0 100px;width:100px;background:#fff;border-radius:12px;padding:12px 8px;text-align:center;border:1px solid var(--c-border);box-shadow:0 1px 4px rgba(20,23,40,.04);}
.prize-card .emoji{font-size:28px;}
.prize-card .name{font-size:11px;font-weight:600;margin-top:6px;color:var(--c-text);}
.prize-card .val{font-size:13px;font-weight:800;color:var(--c-primary);margin-top:2px;}
.prize-card .tag{font-size:9px;color:var(--c-text-3);margin-top:3px;}
.cta-wrap{max-width:480px;margin:0 auto;padding:20px 16px 0;}
.btn-draw{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:60px;border-radius:16px;background:linear-gradient(135deg,#ff7150 0%,#ff5b3e 60%,#e84a2f 100%);color:#fff;font-size:19px;font-weight:800;letter-spacing:2px;box-shadow:0 10px 24px rgba(255,91,62,.4),inset 0 -3px 0 rgba(0,0,0,.1),inset 0 2px 0 rgba(255,255,255,.18);transition:transform .15s;position:relative;overflow:hidden;}
.btn-draw::before{content:"";position:absolute;top:0;left:-100%;width:60%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);animation:shine 2.4s linear infinite;}
@keyframes shine{to{left:120%;}}
.btn-draw:active{transform:scale(.97);}
.cta-hint{text-align:center;font-size:12px;color:var(--c-text-3);margin-top:10px;line-height:1.5;}
.promo-banner{max-width:480px;margin:20px auto 0;padding:0 16px;}
.promo-card{position:relative;border-radius:16px;overflow:hidden;background:linear-gradient(135deg,#ff7150 0%,#ff5b3e 50%,#e84a2f 100%);padding:24px 20px;text-align:center;box-shadow:0 8px 24px rgba(255,91,62,.25);min-height:140px;display:flex;flex-direction:column;justify-content:center;}
.promo-card::before{content:"";position:absolute;top:-30px;right:-20px;width:120px;height:120px;background:rgba(255,255,255,.08);border-radius:50%;}
.promo-card::after{content:"";position:absolute;bottom:-40px;left:-30px;width:100px;height:100px;background:rgba(255,213,74,.1);border-radius:50%;}
.promo-emoji{font-size:42px;position:relative;z-index:1;animation:float-promo 3s ease-in-out infinite;}
@keyframes float-promo{0%,100%{transform:translateY(0);}50%{transform:translateY(-6px);}}
.promo-title{font-size:17px;font-weight:800;color:#fff;margin-top:8px;position:relative;z-index:1;line-height:1.4;}
.promo-sub{font-size:13px;color:rgba(255,255,255,.8);margin-top:4px;position:relative;z-index:1;line-height:1.5;}
.stats-row{display:flex;gap:10px;max-width:480px;margin:16px auto 0;padding:0 16px;}
.stat-card{flex:1;background:#fff;border-radius:12px;padding:14px 10px;text-align:center;border:1px solid var(--c-border);box-shadow:0 1px 3px rgba(20,23,40,.04);}
.stat-card .num{font-size:22px;font-weight:800;color:var(--c-primary);}
.stat-card .label{font-size:11px;color:var(--c-text-3);margin-top:2px;}
.toast-host{position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:6px;pointer-events:none;}
.toast{padding:8px 14px;border-radius:8px;background:rgba(0,0,0,.84);color:#fff;font-size:13px;opacity:0;transform:translateY(-6px);transition:all .2s;}
.toast.show{opacity:1;transform:none;}
.toast.success{background:#16a34a;}
.toast.warning{background:#f59e0b;}
.nav{position:fixed;bottom:0;left:0;right:0;z-index:100;height:calc(56px + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);backdrop-filter:blur(10px);display:flex;border-top:1px solid var(--c-border);z-index:50;padding-bottom:env(safe-area-inset-bottom);}
.nav .tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;color:var(--c-text-3);font-size:10px;}
.nav .tab .ic{font-size:20px;}
.nav .tab.active{color:var(--c-primary);font-weight:600;}
</style>
</head>
<body>
<div class="hero">
<div class="shop-row">
<div class="avatar">🏪</div>
<div><div class="shop-name" id="shopName">加载中…</div><div class="shop-sub" id="shopSub">宜必购盒盒</div></div>
</div>
<div class="chip">⚡ 实时开奖 · 中奖自动进我的</div>
<h1>开始你的<span class="accent">盒盒</span>之旅</h1>
<div class="tagline">折扣券 / 立减券 / 余额赠送 / 免单，中奖后到店消费自动抵扣</div>
</div>
<div class="prizes">
<div class="label">🎰 奖池预览 <span class="count" id="prizeCount"></span></div>
<div class="prize-scroll" id="prizeScroll"></div>
</div>
<div class="cta-wrap">
<button class="btn-draw" id="btnDraw">🎁 盲盒</button>
</div>
<div class="stats-row">
<div class="stat-card"><div class="num" id="statTotal">--</div><div class="label">今日开奖</div></div>
<div class="stat-card"><div class="num" id="statPeople">--</div><div class="label">参与人数</div></div>
<div class="stat-card"><div class="num" id="statRate">--%</div><div class="label">中奖率</div></div>
</div>
<div style="max-width:480px;margin:16px auto 0;padding:0 16px;">
<div style="font-size:14px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:6px;">🎊 全店中奖榜 <span style="font-size:12px;color:var(--c-text-3);font-weight:400;" id="luckyHint"></span></div>
<div id="luckyList"></div>
</div>
<div style="max-width:480px;margin:16px auto 0;padding:0 16px;">
<div style="font-size:14px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:6px;">🎟 我的奖品 <span style="font-size:12px;color:var(--c-text-3);font-weight:400;" id="prizeHint"></span></div>
<div id="prizeHistory"></div>
</div>
<div class="promo-banner">
<div class="promo-card">
<div class="promo-emoji">🎁</div>
<div class="promo-title">抽盒赢好礼 · 中奖率高达 95%</div>
<div class="promo-sub">折扣券 / 立减券 / 余额赠送 / 团购免单<br>中奖后到店消费自动抵扣，快来开始吧</div>
</div>
</div>
<div class="toast-host" id="toastHost"></div>
<nav class="nav">
<div class="tab active" data-go="/h5/customer/index.html"><span class="ic">🎯</span><span>抽盒</span></div>
<div class="tab" data-go="/h5/customer/ibigou.html"><span class="ic">🛒</span><span>商城</span></div>
<div class="tab" data-go="/h5/customer/wallet.html"><span class="ic">👤</span><span>我的</span></div>
</nav>
<script>
const $=id=>document.getElementById(id);
function toast(m,t){const h=$("toastHost");if(!h)return;const e=document.createElement("div");e.className="toast "+(t||"");e.textContent=m;h.appendChild(e);requestAnimationFrame(()=>e.classList.add("show"));setTimeout(()=>{e.classList.remove("show");setTimeout(()=>e.remove(),220)},2600)}
async function req(path,method,body){const p=new URLSearchParams();if(body)Object.keys(body).forEach(k=>{const v=body[k];if(v!=null&&v!=="")p.append(k,v)});const h={};const tk=localStorage.getItem("ibigou_user_token");if(tk)h["X-User-Token"]=tk;const o={method:method||"GET",headers:h};if(method==="POST"||method==="PUT"||method==="DELETE"){h["Content-Type"]="application/x-www-form-urlencoded";o.body=p.toString()}const r=await fetch("/api"+path,o).then(r=>r.json());if(r.code===401||r.code===-1){localStorage.removeItem("ibigou_user_token");toast("登录已过期，请重新登录","warning");const m2=localStorage.getItem("ibigou_merchant_no")||"";setTimeout(()=>{location.href="/h5/customer/login.html?merchantNo="+m2},1500)}return r;}
const get=p=>req(p,"GET");
document.querySelectorAll(".nav .tab").forEach(el=>el.addEventListener("click",()=>{const h=el.dataset.go;if(h&&location.pathname.indexOf(h)===-1)location.href=h}));
const params=new URLSearchParams(location.search);
let mno=params.get("merchantNo")||localStorage.getItem("ibigou_merchant_no")||"";
if(mno)localStorage.setItem("ibigou_merchant_no",mno);
const tk=localStorage.getItem("ibigou_user_token");
const ph=localStorage.getItem("ibigou_phone");
if(!tk||!ph){location.href="/h5/customer/login.html?merchantNo="+(mno||"");}
const typeName={1:"折扣券",2:"立减券",3:"余额赠送",4:"免单",5:"谢谢参与"};
const prizeEmoji={1:"🎫",2:"💸",3:"👤",4:"🧧",5:"👋"};
const SAMPLE_PH=["138****8888","139****6666","159****1234","186****5678","133****9999","152****3333","177****7777","189****0000"];
async function loadShopInfo(){
if(!mno)return;
try{
const r=await get("/customer/wallet/"+ph);
if(r.code===0&&r.data){}
}catch(e){}
try{
const r2=await fetch("/api/merchant/config/weights",{headers:{"X-Merchant-Token":""}}).then(r=>r.json()).catch(()=>null);
if(r2&&r2.code===0&&r2.data){$("shopName").textContent=r2.data.merchantName||mno;$("shopSub").textContent=mno;}
}catch(e){$("shopName").textContent=mno;}
}
async function loadPrizes(){
if(!mno)return;
try{
const r=await get("/customer/wallet/"+ph);
if(r.code===0&&r.data){}
}catch(e){}
var pool=[
{emoji:"🎫",name:"折扣券",val:"5-9.8折",tag:"消费抵扣"},
{emoji:"💸",name:"立减券",val:"¥5-20",tag:"直接抵扣"},
{emoji:"👤",name:"余额赠送",val:"¥5-10",tag:"进我的"},
{emoji:"🧧",name:"团购免单",val:"免单",tag:"团购专属"},
{emoji:"👋",name:"谢谢参与",val:"保底",tag:"返余额"}
];
$("prizeCount").textContent="共 5 类奖品";
$("prizeScroll").innerHTML=pool.map(p=>'<div class="prize-card"><div class="emoji">'+p.emoji+'</div><div class="name">'+p.name+'</div><div class="val">'+p.val+'</div><div class="tag">'+p.tag+'</div></div>').join("");
}
function loadStats(){
$("statTotal").textContent=Math.floor(50+Math.random()*80);
$("statPeople").textContent=Math.floor(30+Math.random()*50);
$("statRate").textContent="95%";
}
$("btnDraw").onclick=function(){
toast("请到店扫码参与盲盒抽奖","info");
};
$("shopName").textContent=mno||"未知商家";
$("shopSub").textContent="宜必购盒盒";
loadPrizes();
loadStats();
loadLuckyList();
loadPrizeHistory();

async function loadLuckyList(){
  if(!mno)return;
  try{
    var r=await get("/customer/recent-wins/"+mno);
    if(r.code===0&&r.data){
      var list=r.data;
      $("luckyHint").textContent=list.length>0?"近 "+list.length+" 条":"";
      if(!list.length){
        $("luckyList").innerHTML='<div style="text-align:center;padding:20px;color:var(--c-text-3);font-size:13px;">暂无中奖记录</div>';
        return;
      }
      var tEmoji={1:"🎫",2:"💸",3:"👤",4:"🧀"};
      var stName={0:"未使用",1:"已使用",2:"已过期"};
      var stColor={0:"var(--c-success)",1:"var(--c-text-3)",2:"var(--c-warning)"};
      $("luckyList").innerHTML=list.map(function(c){
        var t=c.createTime?c.createTime.replace("T"," ").slice(5,16):"";
        return '<div style="display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--c-border);border-radius:10px;padding:10px 12px;margin-bottom:6px;">'
          +'<div style="width:32px;height:32px;border-radius:8px;background:var(--c-primary-100);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">'+(tEmoji[c.prizeType]||"🎫")+'</div>'
          +'<div style="flex:1;min-width:0;"><div style="font-size:12px;font-weight:600;">'+(c.phone||"匿名")+'</div>'
          +'<div style="font-size:12px;color:var(--c-primary);font-weight:600;margin-top:1px;">'+(c.prizeName||"奖品")+'</div></div>'
          +'<span style="font-size:10px;color:'+(stColor[c.status]||"var(--c-text-3)")+';flex-shrink:0;">'+(stName[c.status]||"--")+'</span>'
          +'<span style="font-size:10px;color:var(--c-text-3);flex-shrink:0;margin-left:4px;">'+t+'</span>'
          +'</div>';
      }).join("");
    }else{
      $("luckyList").innerHTML='<div style="text-align:center;padding:20px;color:var(--c-text-3);font-size:13px;">暂无中奖记录</div>';
    }
  }catch(e){$("luckyList").innerHTML='<div style="text-align:center;padding:20px;color:var(--c-text-3);font-size:13px;">加载失败</div>';}
}

async function loadPrizeHistory(){
  if(!ph)return;
  try{
    var r=await get("/customer/wallet/"+ph);
    if(r.code===0&&r.data){
      var coupons=(r.data.available||[]).concat(r.data.pending||[]).concat(r.data.used||[]);
      $("prizeHint").textContent="共 "+coupons.length+" 张";
      if(!coupons.length){
        $("prizeHistory").innerHTML='<div style="text-align:center;padding:24px;color:var(--c-text-3);font-size:13px;"><div style="font-size:32px;margin-bottom:6px;">🎁</div>还没有中奖记录，快去抽盒吧</div>';
        return;
      }
      var tName={1:"折扣券",2:"立减券",3:"余额赠送",4:"免单"};
      var tEmoji={1:"🎫",2:"💸",3:"👤",4:"🧧"};
      var stName={0:"未使用",1:"已使用",2:"已过期"};
      var stColor={0:"var(--c-success)",1:"var(--c-text-3)",2:"var(--c-warning)"};
      $("prizeHistory").innerHTML=coupons.slice(0,10).map(function(c){
        var v=c.prizeType===1?(c.prizeValue+"折"):"¥"+Number(c.prizeValue||0).toFixed(2);
        var st=c.status===0?(c.canUseAfterDraw===0?"待激活":"未使用"):(c.status===1?"已使用":"已过期");
        var sc=c.status===0?(c.canUseAfterDraw===0?"var(--c-warning)":"var(--c-success)"):"var(--c-text-3)";
        var exp=c.validEnd?c.validEnd.replace("T"," ").slice(0,10):"";
        return '<div style="display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--c-border);border-radius:12px;padding:12px;margin-bottom:8px;">'
          +'<div style="width:44px;height:44px;border-radius:10px;background:var(--c-primary-100);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;">'+(tEmoji[c.prizeType]||"🎁")+'</div>'
          +'<div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:600;">'+(tName[c.prizeType]||"奖品")+' · '+v+'</div>'
          +(exp?'<div style="font-size:11px;color:var(--c-text-3);margin-top:2px;">到期 '+exp+'</div>':'')
          +(c.sourceMerchantNo?'<div style="font-size:11px;color:var(--c-text-3);">来源 '+c.sourceMerchantNo+'</div>':'')+'</div>'
          +'<span style="font-size:11px;font-weight:600;color:'+sc+';flex-shrink:0;">'+st+'</span>'
          +'</div>';
      }).join("");
    }
  }catch(e){}
}
</script>
</body>
</html>

